# Production data layer
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters. Keep server-only.
SESSION_SECRET=
RATE_LIMIT_SALT=

# Used only to build absolute password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development only. If Supabase variables are missing, demo mode activates
# automatically. Set true to force demo while local credentials exist.
# The app always refuses demo mode in production.
RUMBO_DEMO_MODE=false
